# Copy to .env for local development. Never commit the real .env file.

# AWS
AWS_REGION=us-east-1
# Local profile name used by `sam local` / scripts. Not required for pure `sam local start-api`.
AWS_PROFILE=

# DynamoDB table (created by IaC; injected as a Lambda env var in deployed environments)
APPLICATIONS_TABLE_NAME=

# S3 bucket for uploaded documents (created by IaC)
DOCUMENTS_BUCKET_NAME=

# Deadline budget (see shared/deadline) — internal target, must stay below the 45s hard ceiling
DEADLINE_TARGET_MS=35000

# Pre-signed upload URL time-to-live, in seconds
PRESIGN_TTL_SECONDS=300

# AI evaluation provider: "mock" (default, no external calls) or "anthropic"
AI_PROVIDER=mock
# Only required when AI_PROVIDER is not "mock". Sourced from SSM SecureString in deployed
# environments — this variable is for local development only, never for production.
AI_API_KEY=

# Log level for the structured logger
LOG_LEVEL=info

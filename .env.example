# Copy to .env for local development. Never commit the real .env file.

# AWS
AWS_REGION=us-east-1
# Local profile name used by `sam local` / scripts. Not required for pure `sam local start-api`.
AWS_PROFILE=

# DynamoDB table (created by IaC; injected as a Lambda env var in deployed environments)
APPLICATIONS_TABLE_NAME=

# Persistence adapter: "dynamodb" (default; requires APPLICATIONS_TABLE_NAME + AWS
# credentials, or DYNAMODB_SERVICE_URL pointed at DynamoDB Local) or "inmemory"
# (pure local dev/testing, no AWS/DynamoDB Local needed at all).
PERSISTENCE_PROVIDER=dynamodb

# Only read when PERSISTENCE_PROVIDER=dynamodb. Unset in every deployed environment --
# set this locally to point the real repository at DynamoDB Local instead of AWS, e.g.
# http://localhost:8000. See README "Testing the /v1/applications endpoints".
DYNAMODB_SERVICE_URL=

# S3 bucket for uploaded documents (created by IaC). Only read when
# PERSISTENCE_PROVIDER=dynamodb (the "real adapters" branch) -- PERSISTENCE_PROVIDER=inmemory
# uses an in-memory document store instead and needs neither this nor S3_SERVICE_URL.
DOCUMENTS_BUCKET_NAME=

# Unset in every deployed environment -- set this locally to point the real S3
# adapter at a local S3-compatible endpoint instead of AWS, mirroring DYNAMODB_SERVICE_URL.
S3_SERVICE_URL=

# Deadline budget (see src/Gweb.Shared/Deadline) — internal target, must stay below the 45s hard ceiling
DEADLINE_TARGET_MS=35000

# Pre-signed upload URL time-to-live, in seconds
PRESIGN_TTL_SECONDS=300

# AI evaluation provider: "mock" (default, no external calls) or "gemini"
AI_PROVIDER=mock
# Only required when AI_PROVIDER=gemini. Sourced from SSM SecureString in a real
# deployment (see infra/template.yaml's AiApiKey parameter and docs/06-COLLABORATION-PROTOCOL.md)
# -- this variable is for local development only, never committed.
AI_API_KEY=
# Only read when AI_PROVIDER=gemini. An env var, not hardcoded, because Google's
# free-tier model lineup has already changed twice during this project's build --
# see docs/adr/0006-ai-evaluation-provider.md. gemini-3.5-flash-lite (500 free
# requests/day) rather than gemini-3.6-flash (20/day) -- easy to exhaust during
# grading/demoing otherwise.
GEMINI_MODEL=gemini-3.5-flash-lite

# Log level for the structured logger
LOG_LEVEL=info
